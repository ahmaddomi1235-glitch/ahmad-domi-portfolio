{
  "name": "ahmad-domi-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/content/validate-content.ts",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "content:youtube": "node scripts/content/import-youtube.ts",
    "content:transcripts": "node scripts/content/normalize-transcript.ts",
    "content:draft": "node scripts/content/generate-content-draft.ts",
    "verify": "npm run lint && npm run typecheck && npm run validate && npm run test:unit && npm run build",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
